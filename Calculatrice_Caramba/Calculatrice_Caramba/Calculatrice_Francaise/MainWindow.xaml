<Window x:Class="Calculatrice_Caramba.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Calculatrice Caramba" Height="560" Width="360"
 MinHeight="540" MinWidth="340" Background="#F2F4F7"
 WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="FontSize" Value="19"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="Padding" Value="5"/>
  </Style>
 </Window.Resources>
 <Grid Margin="10">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <TextBox x:Name="Ecran" Grid.Row="0" Height="75" FontSize="30"
   Text="0" IsReadOnly="True" TextAlignment="Right"
   VerticalContentAlignment="Center" Margin="3,3,3,10" Padding="8"/>
  <UniformGrid Grid.Row="1" Columns="4" Rows="6">
   <Button Content="C" Click="Effacer_Click"/>
   <Button Content="±" Click="Signe_Click"/>
   <Button Content="%" Click="Pourcentage_Click"/>
   <Button Content="÷" Click="Operateur_Click"/>
   <Button Content="sin" Click="Sinus_Click"/>
   <Button Content="cos" Click="Cosinus_Click"/>
   <Button Content="tan" Click="Tangente_Click"/>
   <Button Content="√" Click="Racine_Click"/>
   <Button Content="7" Click="Chiffre_Click"/>
   <Button Content="8" Click="Chiffre_Click"/>
   <Button Content="9" Click="Chiffre_Click"/>
   <Button Content="×" Click="Operateur_Click"/>
   <Button Content="4" Click="Chiffre_Click"/>
   <Button Content="5" Click="Chiffre_Click"/>
   <Button Content="6" Click="Chiffre_Click"/>
   <Button Content="−" Click="Operateur_Click"/>
   <Button Content="1" Click="Chiffre_Click"/>
   <Button Content="2" Click="Chiffre_Click"/>
   <Button Content="3" Click="Chiffre_Click"/>
   <Button Content="+" Click="Operateur_Click"/>
   <Button Content="0" Click="Chiffre_Click"/>
   <Button Content="," Click="Virgule_Click"/>
   <Button Content="=" Click="Egal_Click"/>
   <Button Content="C" Click="Effacer_Click"/>
  </UniformGrid>
 </Grid>
</Window>
